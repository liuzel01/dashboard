{
  "name": "eks-dashboard-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "init-admin": "node scripts/init-admin.js",
    "verify:kms-values": "node scripts/verify-kms-value-role.js",
    "build": "nest build",
    "build:agent": "tsc -p tsconfig.build.json --outDir dist-agent",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:agent": "nest start --entryFile agent-main",
    "start:agent:dev": "nest start --watch --entryFile agent-main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:agent:prod": "node dist-agent/agent-main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@aws-sdk/client-acm": "^3.1083.0",
    "@aws-sdk/client-ec2": "^3.888.0",
    "@aws-sdk/client-eks": "^3.634.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.891.0",
    "@aws-sdk/client-kms": "^3.1136.0",
    "@aws-sdk/client-route-53": "^3.891.0",
    "@aws-sdk/client-s3": "^3.1005.0",
    "@aws-sdk/client-ssm": "^3.888.0",
    "@aws-sdk/client-sts": "^3.634.0",
    "@aws-sdk/credential-provider-env": "^3.888.0",
    "@aws-sdk/credential-providers": "^3.891.0",
    "@aws-sdk/s3-request-presigner": "^3.1005.0",
    "@kubernetes/client-node": "^0.21.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/websockets": "^11.1.6",
    "@prometheus-io/client": "^0.16.1",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.2",
    "ioredis": "^5.7.0",
    "js-yaml": "^4.3.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "jwks-rsa": "^3.2.0",
    "mysql2": "^3.15.0",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "ssh2": "^1.11.0",
    "tunnel-ssh": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.18.1",
    "@types/supertest": "^6.0.2",
    "@types/tunnel-ssh": "^5.0.4",
    "cross-env": "^10.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:@scure/base|@noble/hashes|otplib|@otplib)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
