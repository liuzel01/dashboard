# .env file
DB_HOST=1.2.3.4
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=spot
LINE_VERIFY_API_URL=http://172.31.29.3:3000/api/lines
# 线路运行期参数（inventory_probe/availability/provider/ssl）由 系统管理 → siteconf 配置 管理
# line.inventory_probe.* / line.availability.* / line.provider.* / line.ssl.*
DCDN_CERT_SOURCE=cas
DCDN_CERT_REGION=ap-southeast-1
CAS_ENDPOINT=https://cas.ap-southeast-1.aliyuncs.com
CAS_API_VERSION=2020-04-07
# 可选：开启 DCDN WAF 时使用的 ClientIpTag（例如 X-Forwarded-For）
DCDN_WAF_CLIENT_IP_TAG=

# SSO (Keycloak)
# Keycloak / SSO 配置由 系统管理 → siteconf 配置 管理：sso.keycloak.* / sso.frontend.*

# AI Ops
# AIOPS 配置由 系统管理 → siteconf 配置 管理
# aiops.llm.provider / aiops.openclaw.base_url / aiops.openclaw.model / aiops.openclaw.timeout_ms
# aiops.nl2sql.fewshot_cases_path / aiops.nl2sql.fewshot_max_cases / aiops.sql.*
# AIOPS SQL 全局兜底白名单也在 aiops.sql.whitelist_*，环境级 database.aiops 仍优先

# Query Center Gateway
# Gateway runtime switches/timeouts/allowlist/denylist/transport, Agent K8s target and token are managed in 系统管理 → siteconf 配置:
# query_center.gateway.* / query_center.agent.*
