# .env file
DB_HOST=1.2.3.4
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=spot
LINE_VERIFY_API_URL=http://172.31.29.3:3000/api/lines
# 线路总览探测聚合接口（建议显式配置；未配置时会尝试从 LINE_VERIFY_API_URL 推导）
LINE_INVENTORY_PROBE_API_URL=http://172.31.29.3:3000/api/probes/latest
# 可用性判定时间窗（毫秒）
LINE_AVAILABILITY_WINDOW_MS=120000
# 探测快照缓存 TTL（毫秒）
LINE_AVAILABILITY_CACHE_TTL_MS=15000
# 调用探测接口超时（毫秒）
LINE_AVAILABILITY_HTTP_TIMEOUT_MS=3000
# 可用判定阈值（支持 0~1 或 0~100，如 0.8 或 80）
LINE_AVAILABILITY_UP_THRESHOLD=0.8
# provider 识别缓存 TTL（毫秒）
LINE_PROVIDER_CACHE_TTL_MS=3600000
# provider 规则扩展（JSON 数组，和内置规则合并）
LINE_PROVIDER_RULES_JSON=[{"name":"aliyun-esa-initx","provider":"aliyun_esa","pattern":"\\.a1\\.init[a-z0-9]+\\.com$","flags":"i"},{"name":"aliyun-dcdn-cdngslb","provider":"aliyun_dcdn","pattern":"\\.w\\.cdngslb\\.com$","flags":"i"},{"name":"aliyun-dcdn-queniuaa","provider":"aliyun_dcdn","pattern":"(^|\\.)queniuaa\\.com$","flags":"i"},{"name":"aws-ga","provider":"aws_global","pattern":"\\.awsglobalaccelerator\\.com$","flags":"i"}]
# 线路证书聚合缓存 TTL（毫秒）
LINE_SSL_CACHE_TTL_MS=300000
# TLS 证书探测超时（毫秒）
LINE_SSL_TLS_TIMEOUT_MS=5000
# 线路证书并发探测数量
LINE_SSL_RESOLVE_CONCURRENCY=8
DCDN_ENDPOINT=https://dcdn.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=your-aliyun-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-ram-access-key-secret
DCDN_CERT_SOURCE=cas
DCDN_CERT_REGION=ap-southeast-1
CAS_ENDPOINT=https://cas.ap-southeast-1.aliyuncs.com
CAS_API_VERSION=2020-04-07
# 可选：开启 DCDN WAF 时使用的 ClientIpTag（例如 X-Forwarded-For）
DCDN_WAF_CLIENT_IP_TAG=

# SSO (Keycloak)
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
# Keycloak 回调（后端处理 code）
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
# 可选：支持多个后端回调地址（逗号分隔）
KEYCLOAK_REDIRECT_URIS=http://localhost:3000/api/auth/keycloak/callback,http://your-api-domain/api/auth/keycloak/callback
# 登录成功后回到前端页面
SSO_FRONTEND_REDIRECT_URI=http://localhost:5173/sso/callback
# 可选：支持多个前端回跳地址（逗号分隔）
SSO_FRONTEND_REDIRECT_URIS=http://localhost:5173/sso/callback,http://your-domain/sso/callback

# AI Ops
AIOPS_LLM_PROVIDER=openclaw
AIOPS_OPENCLAW_BASE_URL=http://127.0.0.1:18949/v1
AIOPS_OPENCLAW_TOKEN=replace-with-openclaw-gateway-token
AIOPS_OPENCLAW_MODEL=openclaw/default
# OpenClaw chat/completions 请求超时（毫秒，默认 20000）
AIOPS_OPENCLAW_TIMEOUT_MS=20000
# few-shot 样例 CSV（可选，默认会自动尝试 ../docs/ai-ops-fewshot-data/nl2sql_fewshot_cases.csv）
AIOPS_NL2SQL_FEWSHOT_CASES_PATH=
# 每次注入到提示词中的样例数量（可选，默认 6）
AIOPS_NL2SQL_FEWSHOT_MAX_CASES=6
AIOPS_EVENT_INGEST_TOKEN=replace-with-random-token
# 全局兜底白名单（可选，优先使用 environments_config.database.aiops）
# whitelist 语义：* / db.* / db.table / table（table 为跨库同名匹配，建议优先用 db.* 或 db.table）
AIOPS_SQL_WHITELIST_TABLES=
# whitelist_databases 语义：* / db / db.*
AIOPS_SQL_WHITELIST_DATABASES=
AIOPS_SQL_DEFAULT_LIMIT=200
AIOPS_SQL_MAX_LIMIT=1000
AIOPS_SQL_TIMEOUT_MS=5000

# Query Center Gateway
# Gateway runtime switches/timeouts/allowlist/denylist/transport are managed in 系统管理 → siteconf 配置:
# query_center.gateway.enabled / timeout_ms / env_allowlist / env_denylist / transport
# k8s-proxy 模式下的 Agent Service 定位
QUERY_CENTER_AGENT_K8S_NAMESPACE=default
QUERY_CENTER_AGENT_K8S_SERVICE=dashboard-db-gateway-agent
QUERY_CENTER_AGENT_K8S_PORT=8080
# 与 agent 侧 AGENT_SHARED_TOKEN 保持一致
QUERY_CENTER_AGENT_TOKEN=replace-with-agent-shared-token
