# .env file
DB_HOST=1.2.3.4
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=spot
LINE_VERIFY_API_URL=http://172.31.29.3:3000/api/lines
# 线路总览探测聚合接口（建议显式配置；未配置时会尝试从 LINE_VERIFY_API_URL 推导）
LINE_INVENTORY_PROBE_API_URL=http://172.31.29.3:3000/api/probes/latest
# 线路运行期参数（availability/provider/ssl）由 系统管理 → siteconf 配置 管理
# line.availability.* / line.provider.* / line.ssl.*
DCDN_ENDPOINT=https://dcdn.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=your-aliyun-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-ram-access-key-secret
DCDN_CERT_SOURCE=cas
DCDN_CERT_REGION=ap-southeast-1
CAS_ENDPOINT=https://cas.ap-southeast-1.aliyuncs.com
CAS_API_VERSION=2020-04-07
# 可选：开启 DCDN WAF 时使用的 ClientIpTag（例如 X-Forwarded-For）
DCDN_WAF_CLIENT_IP_TAG=

# SSO (Keycloak)
# Keycloak / SSO 非密钥配置由 系统管理 → siteconf 配置 管理
# sso.keycloak.* / sso.frontend.*；KEYCLOAK_CLIENT_SECRET 仍保留在 env/Secret
KEYCLOAK_CLIENT_SECRET=your-client-secret

# AI Ops
AIOPS_LLM_PROVIDER=openclaw
AIOPS_OPENCLAW_BASE_URL=http://127.0.0.1:18949/v1
AIOPS_OPENCLAW_TOKEN=replace-with-openclaw-gateway-token
AIOPS_OPENCLAW_MODEL=openclaw/default
# AIOPS 运行期参数（OpenClaw timeout / fewshot max / SQL limit & timeout）由 系统管理 → siteconf 配置 管理
# aiops.openclaw.timeout_ms / aiops.nl2sql.fewshot_max_cases / aiops.sql.*
# few-shot 样例 CSV（可选，默认会自动尝试 ../docs/ai-ops-fewshot-data/nl2sql_fewshot_cases.csv）
AIOPS_NL2SQL_FEWSHOT_CASES_PATH=
AIOPS_EVENT_INGEST_TOKEN=replace-with-random-token
# 全局兜底白名单（可选，优先使用 environments_config.database.aiops）
# whitelist 语义：* / db.* / db.table / table（table 为跨库同名匹配，建议优先用 db.* 或 db.table）
AIOPS_SQL_WHITELIST_TABLES=
# whitelist_databases 语义：* / db / db.*
AIOPS_SQL_WHITELIST_DATABASES=

# Query Center Gateway
# Gateway runtime switches/timeouts/allowlist/denylist/transport are managed in 系统管理 → siteconf 配置:
# query_center.gateway.enabled / timeout_ms / env_allowlist / env_denylist / transport
# k8s-proxy 模式下的 Agent Service 定位
QUERY_CENTER_AGENT_K8S_NAMESPACE=default
QUERY_CENTER_AGENT_K8S_SERVICE=dashboard-db-gateway-agent
QUERY_CENTER_AGENT_K8S_PORT=8080
# 与 agent 侧 AGENT_SHARED_TOKEN 保持一致
QUERY_CENTER_AGENT_TOKEN=replace-with-agent-shared-token
