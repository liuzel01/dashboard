# .env file
DB_HOST=1.2.3.4
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_DATABASE=spot
VLINK_API_URL=https://vlink2-yyds.vlink1tenant.shop
LINE_VERIFY_API_URL=http://172.31.29.3:3000/api/lines
DCDN_ENDPOINT=https://dcdn.aliyuncs.com
ALIYUN_ACCESS_KEY_ID=your-aliyun-ram-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-ram-access-key-secret
DCDN_CERT_SOURCE=cas
DCDN_CERT_REGION=ap-southeast-1
CAS_ENDPOINT=https://cas.ap-southeast-1.aliyuncs.com
CAS_API_VERSION=2020-04-07
# 可选：开启 DCDN WAF 时使用的 ClientIpTag（例如 X-Forwarded-For）
DCDN_WAF_CLIENT_IP_TAG=

# SSO (Keycloak)
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/your-realm
KEYCLOAK_CLIENT_ID=your-client-id
KEYCLOAK_CLIENT_SECRET=your-client-secret
# Keycloak 回调（后端处理 code）
KEYCLOAK_REDIRECT_URI=http://localhost:3000/api/auth/keycloak/callback
# 可选：支持多个后端回调地址（逗号分隔）
KEYCLOAK_REDIRECT_URIS=http://localhost:3000/api/auth/keycloak/callback,http://your-api-domain/api/auth/keycloak/callback
# 登录成功后回到前端页面
SSO_FRONTEND_REDIRECT_URI=http://localhost:5173/sso/callback
# 可选：支持多个前端回跳地址（逗号分隔）
SSO_FRONTEND_REDIRECT_URIS=http://localhost:5173/sso/callback,http://your-domain/sso/callback
