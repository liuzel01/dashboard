{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustExistingHashexSourceRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::017820696647:root" },
      "Action": "sts:AssumeRole",
      "Condition": { "ArnEquals": { "aws:PrincipalArn": "arn:aws:iam::017820696647:role/hashex-dashboard-eks-source-role" } }
    },
    {
      "Sid": "TrustDashboardEc2InstanceRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::931324892624:role/mgbx-eks-dashboard-role" },
      "Action": "sts:AssumeRole"
    }
  ]
}
